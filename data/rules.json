{
  "version": 1,
  "_doc": "芯核適配度檢查器的所有數字。對應 docs/spec.md 第 2 節（芯核系統規則）、第 5 節（評分規則）、第 6 節（長歪判定）、第 7 節（結果門檻）。改權重或門檻只要改這裡，不用動程式。",

  "stats": {
    "critRate":    { "label": "暴擊",     "unit": "%" },
    "critDmg":     { "label": "暴傷",     "unit": "%" },
    "weakDmg":     { "label": "虛弱增傷", "unit": "%" },
    "atkPct":      { "label": "攻擊加成", "unit": "%" },
    "defPct":      { "label": "防禦加成", "unit": "%" },
    "hpPct":       { "label": "生命加成", "unit": "%" },
    "atkFlat":     { "label": "攻擊",     "unit": "" },
    "defFlat":     { "label": "防禦",     "unit": "" },
    "hpFlat":      { "label": "生命",     "unit": "" },
    "energyRegen": { "label": "加速回能", "unit": "%" },
    "oathEnergy":  { "label": "誓約回能", "unit": "%" },
    "oathDmg":     { "label": "誓約增傷", "unit": "%" }
  },

  "rarities": {
    "SSR": { "label": "金 SSR", "maxLevel": 15, "scored": true,  "scoreMultiplier": 1.0, "tag": null },
    "SR":  { "label": "紫 SR",  "maxLevel": 12, "scored": true,  "scoreMultiplier": 0.6, "tag": "過渡用" },
    "R":   { "label": "藍 R",   "maxLevel": 9,  "scored": false, "scoreMultiplier": 0,   "tag": "直接拆" }
  },

  "slots": {
    "alpha": { "symbol": "α", "nick": "錐子", "card": "日冕卡", "mainOptions": ["hpFlat"], "mainFixed": "hpFlat" },
    "beta":  { "symbol": "β", "nick": "方塊", "card": "日冕卡", "mainOptions": ["atkPct", "defPct", "hpPct", "oathEnergy", "oathDmg", "energyRegen"], "mainFixed": null },
    "gamma": { "symbol": "γ", "nick": "海膽", "card": "月暉卡", "mainOptions": ["atkFlat"], "mainFixed": "atkFlat" },
    "delta": { "symbol": "δ", "nick": "三角", "card": "月暉卡", "mainOptions": ["atkPct", "defPct", "hpPct", "critRate", "critDmg", "weakDmg"], "mainFixed": null }
  },

  "mainStatAt15": {
    "_doc": "SSR 主詞條 +15 參考值（只用來顯示，不參與計算）",
    "hpFlat": 3000, "atkFlat": 200, "energyRegen": 24, "oathDmg": 14, "critRate": 11.2, "weakDmg": 18.2
  },

  "stellactra": ["綠珥", "藍弧", "紫輝", "黃璃", "紅漪", "粉珀"],

  "upgradeEvery": 3,
  "maxSubstats": 4,
  "subOptions": ["critRate", "critDmg", "weakDmg", "atkPct", "defPct", "hpPct", "atkFlat", "defFlat", "hpFlat"],

  "substats": {
    "_doc": "SSR 副詞條。initMin/initMax＝初始值範圍；stepMin/stepMax＝每次強化範圍；cap＝理論上限；grid＝評分用的 1 格（單次強化最大值）；mid＝長歪判定用的單次強化中間值",
    "critRate": { "initMin": 1.1, "initMax": 1.6,  "stepMin": 0.55, "stepMax": 0.8,  "cap": 5.6,  "grid": 0.8, "mid": 0.675 },
    "critDmg":  { "initMin": 2.2, "initMax": 3.2,  "stepMin": 1.1,  "stepMax": 1.6,  "cap": 11.2, "grid": 1.6, "mid": 1.35 },
    "weakDmg":  { "initMin": 1.8, "initMax": 2.6,  "stepMin": 0.9,  "stepMax": 1.3,  "cap": 9.1,  "grid": 1.3, "mid": 1.1 },
    "atkPct":   { "initMin": 7,   "initMax": 10,   "stepMin": 3.5,  "stepMax": 5,    "cap": 35,   "grid": 5,   "mid": 4.25 },
    "defPct":   { "initMin": 7,   "initMax": 10,   "stepMin": 3.5,  "stepMax": 5,    "cap": 35,   "grid": 5,   "mid": 4.25 },
    "hpPct":    { "initMin": 7,   "initMax": 10,   "stepMin": 3.5,  "stepMax": 5,    "cap": 35,   "grid": 5,   "mid": 4.25 },
    "atkFlat":  { "initMin": 40,  "initMax": 60,   "stepMin": 20,   "stepMax": 30,   "cap": 210,  "grid": 30,  "mid": 25 },
    "defFlat":  { "initMin": 20,  "initMax": 30,   "stepMin": 10,   "stepMax": 15,   "cap": 105,  "grid": 15,  "mid": 12.5 },
    "hpFlat":   { "initMin": 800, "initMax": 1200, "stepMin": 400,  "stepMax": 600,  "cap": 4200, "grid": 600, "mid": 500 }
  },

  "scoring": {
    "mainShare": 0.35,
    "subShare": 0.65,
    "_weightsDoc": "副詞條權重：weights[流派][搭檔型別][詞條]。第一版估值，待真實芯核校準。",
    "weights": {
      "crit": {
        "atk": { "critRate": 1.0, "critDmg": 1.0, "weakDmg": 0.6, "atkPct": 0.8, "defPct": 0,   "hpPct": 0,   "atkFlat": 0.4, "defFlat": 0,   "hpFlat": 0 },
        "def": { "critRate": 1.0, "critDmg": 1.0, "weakDmg": 0.6, "atkPct": 0.4, "defPct": 0.8, "hpPct": 0,   "atkFlat": 0.2, "defFlat": 0.4, "hpFlat": 0 },
        "hp":  { "critRate": 1.0, "critDmg": 1.0, "weakDmg": 0.6, "atkPct": 0.4, "defPct": 0,   "hpPct": 0.8, "atkFlat": 0.2, "defFlat": 0,   "hpFlat": 0.4 }
      },
      "weak": {
        "atk": { "critRate": 0.3, "critDmg": 0.3, "weakDmg": 1.0, "atkPct": 0.8, "defPct": 0,   "hpPct": 0,   "atkFlat": 0.4, "defFlat": 0,   "hpFlat": 0 },
        "def": { "critRate": 0.3, "critDmg": 0.3, "weakDmg": 1.0, "atkPct": 0.4, "defPct": 0.8, "hpPct": 0,   "atkFlat": 0.2, "defFlat": 0.4, "hpFlat": 0 },
        "hp":  { "critRate": 0.3, "critDmg": 0.3, "weakDmg": 1.0, "atkPct": 0.4, "defPct": 0,   "hpPct": 0.8, "atkFlat": 0.2, "defFlat": 0,   "hpFlat": 0.4 }
      }
    },
    "_mainDoc": "主詞條分數（只算 β、δ）。fixed 裡的詞條直接給分；typedPct 是「對應型別的加成」；otherPct 是不對應的加成。δ 虛弱流的暴擊／暴傷 0.3 是沿用副詞條權重的假設，規格書沒寫。",
    "main": {
      "beta": {
        "crit": { "fixed": { "energyRegen": 1.0, "oathEnergy": 1.0, "oathDmg": 1.0 }, "typedPct": 0.8, "otherPct": 0.2 },
        "weak": { "fixed": { "energyRegen": 1.0, "oathEnergy": 1.0, "oathDmg": 1.0 }, "typedPct": 0.8, "otherPct": 0.2 }
      },
      "delta": {
        "crit": { "fixed": { "critRate": 1.0, "critDmg": 1.0, "weakDmg": 0.8 }, "typedPct": 0.8, "otherPct": 0.2 },
        "weak": { "fixed": { "weakDmg": 1.0, "critRate": 0.3, "critDmg": 0.3 }, "typedPct": 0.8, "otherPct": 0.2 }
      }
    },
    "typePct": { "atk": "atkPct", "def": "defPct", "hp": "hpPct" },
    "_unknownDoc": "型別待查的搭檔：三種型別都算，取最低分當保守值，而且不參加「最適合的搭檔」評選",
    "unknownTypePolicy": "min"
  },

  "growth": {
    "goodWeight": 0.8,
    "_ratioDoc": "比例用分子／分母存，避免 2/3 寫成小數時的進位誤差",
    "greatRatio": { "num": 2, "den": 3 },
    "badRatio": { "num": 1, "den": 3 },
    "labels": {
      "notStarted": { "text": "還沒開始長", "advice": "看初始詞條就好，先升到 +3 看第一次強化" },
      "great":      { "text": "長得很好",   "advice": "值得繼續升" },
      "normal":     { "text": "普通",       "advice": "看適配分決定" },
      "bad":        { "text": "長歪了",     "advice": "停手，考慮拆掉回收芯核能量" }
    }
  },

  "verdict": {
    "keepMin": 75,
    "holdMin": 55,
    "texts": {
      "keep":  "留，升滿",
      "hold":  "先留著",
      "scrap": "拆"
    }
  },

  "dots": { "greenMin": 75, "yellowMin": 55 }
}
